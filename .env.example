# ── Email delivery (Amazon SES — shared Webit365 account) ──────────────
# Quote + job-application forms email the owner via SES. Copy these four
# values from another Webit365 Vercel project (same AWS account / IAM user).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Verified sender on the webit365.com SES domain.
SES_FROM=Lakeside Outdoor Services <no-reply@webit365.com>
# Who form submissions go to (comma-separated). Defaults in code to
# dave@lakesidenny.com, aerial1002@gmail.com — set this only to change it.
LEAD_TO_EMAIL=dave@lakesidenny.com, aerial1002@gmail.com

# ── Live Google reviews via Featurable (https://featurable.com — free) ──
# Create a widget, connect your Google Business Profile, then Embed → API to
# copy the widget ID. Until this is set, the reviews section shows only the
# verified review(s) hard-coded in src/lib/reviews.ts (no placeholders).
FEATURABLE_WIDGET_ID=
