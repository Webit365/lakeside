# Email delivery for the quote form (https://resend.com)
RESEND_API_KEY=
# Where quote submissions are sent
LEAD_TO_EMAIL=dave@lakesidenny.com
# Verified sender address on your Resend-verified domain
LEAD_FROM_EMAIL=quotes@lakesidenny.com

# Live Google reviews via Featurable (https://featurable.com — free).
# Create a widget, connect your Google Business Profile, then Embed → API to
# copy the widget ID. Until this is set, the reviews section shows only the
# verified review(s) hard-coded in src/lib/reviews.ts (no placeholders).
FEATURABLE_WIDGET_ID=
